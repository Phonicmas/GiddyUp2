<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Version>1.7</Version>
        <LangVersion>latest</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
    	<GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>..\$(Version)\Assemblies</OutputPath>
        <DefineConstants>TRACE;NDEBUG</DefineConstants>
        <WarningLevel>4</WarningLevel>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>Embedded</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>..\$(Version)\Assemblies</OutputPath>
        <DefineConstants>TRACE;DEBUG;NETFRAMEWORK;NET48;</DefineConstants>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*-*" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DevTools\DevTools\DevTools.csproj" />
      <ProjectReference Include="..\Source\GiddyUpCore.csproj" />
    </ItemGroup>

</Project>
